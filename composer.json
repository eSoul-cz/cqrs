{
  "name": "esoul-cz/cqrs",
  "description": "Simple CQRS implementation.",
  "type": "library",
  "license": "gpl-2.0-or-later",
  "authors": [
    {
      "name": "Tomáš Vojík",
      "email": "vojik@esoul.cz"
    }
  ],
  "require": {
    "php": ">=8.5"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^13.1",
    "esoul-cz/coding-standard": "^0.1"
  },
  "autoload": {
    "psr-4": {
      "Esoul\\Cqrs\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G --no-progress",
    "cs": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
